# ZENTRA Hunter — environment configuration
# Copy this file to .env and edit. Everything here is optional except APP_SECRET
# in production. API keys entered in the Settings UI are encrypted in the database.

PORT=8787

# 0.0.0.0 lets your phone reach the dashboard over the same WiFi (LAN).
# Use 127.0.0.1 to keep it on this computer only.
HOST=0.0.0.0

# Long random string used to encrypt credentials at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If omitted, a key is generated once in data/.app_secret
APP_SECRET=

# Optional: create the dashboard password on first boot instead of using the setup screen.
# Remove this after the first start.
APP_PASSWORD=

# Session cookies are marked Secure automatically when a request arrives over HTTPS
# (x-forwarded-proto), which covers Cloudflare Tunnel and other reverse proxies.
# Set to "true" only if you always use HTTPS — plain-HTTP LAN logins would stop working.
SECURE_COOKIES=false
